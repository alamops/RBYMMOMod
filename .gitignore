# macOS
.DS_Store

# editors
.vscode/
.idea/
*.swp

# packaged mod archives (built by `modkit pack`)
*.modpkg

# end-to-end driver output
/shots/

# machine-specific test config (ROM path, addresses) -- see .env.example
.env

# e2e scratch output (the Gen 1 sibling predates this and is tracked)
tmp/e2e-battlefield-gen2/
tmp/e2e-solo-battle/
# ROM-composited frames from screenshot drivers. lint does not catch a
# whole frame (same rule as docs/screenshots/ in .modkitignore).
tmp/e2e-classic/
tmp/e2e-review/
tmp/e2e-battlefield/*.log

# Node-hub e2e referee dump (runtime scratch; item ids must never appear)
npc_bags.txt
npc_bags_refuse_test.txt
