return {
  summary = "Play Kanto with friends: see them walk, team up, chat, trade "
    .. "and battle.",
  author = "alamo",
  tags = { "multiplayer", "mmo", "chat", "party", "trade", "ui",
           "experimental" },

  differences = {
    changed = {
      "Adds an MMO row to the START menu (above SAVE).",
      "Draws nicknames and chat bubbles over other players in the overworld.",
      "Spawns runtime NPCs for other players on your current map.",
    },
    added = {
      "HOST GAME and JOIN GAME in the MMO menu -- no separate server to "
        .. "install; one player hosts from inside the game and picks the "
        .. "limit (2-64) while doing it.",
      "Global, nearby, party and private chat, composed on the naming grid.",
      "Parties of two: invite a friend from the menu you get by walking up "
        .. "and pressing A, and travel together -- open the TOWN MAP and "
        .. "their character is standing at the city they are in, they are "
        .. "on your map as their own character with their nickname over its "
        .. "head marked with the cursor glyph, the PLAYERS list marks them, "
        .. "and a members list carries both trainer cards and a chat scope "
        .. "that reaches them anywhere.",
      "Trade and battle requests from anywhere, run by the engine's own "
        .. "link code over the hub.",
      "A number page on this mod's naming screens, because the vanilla "
        .. "grid has no digits and an address cannot be typed without one.",
    },
    known = {
      "No NAT traversal. A host behind a router must forward port 7788 for "
        .. "anyone outside their LAN; a standalone hub (server/hub.js) on a "
        .. "public box is the alternative.",
      "No host migration when a player is the host. Hosting from the game "
        .. "runs the relay inside that copy, so if the host leaves the game "
        .. "ends for everyone -- they are told rather than left hanging, and "
        .. "nobody else can take it over. A dedicated hub has no host at all: "
        .. "a player leaving is just a player leaving.",
      "Remote players freeze mid-step while you have a menu or text box "
        .. "open, and resume when you close it. The engine updates only the "
        .. "top state, so the whole overworld pauses under a modal -- this "
        .. "is the same thing vanilla NPCs do.",
      "The player limit is 2-64, host included, and is clamped in three "
        .. "places so it cannot be set out of range by editing a file.",
      "Hosting opens a port with no authentication: anyone who can reach "
        .. "it can join under any name, and positions are self-reported, so "
        .. "NEARBY chat is not an enforceable boundary. Host for people you "
        .. "know. Idle connections, payload shape and chat rate are bounded; "
        .. "identity is not.",
      "Two implementations of one protocol -- Hub.lua in-game and hub.js "
        .. "for a dedicated server -- can drift. Both are pinned by suites "
        .. "asserting the same behaviours, but it is a real upkeep cost.",
      "Nameplates are positioned from the tile offset to your own player, "
        .. "because the mod API exposes no camera position. At a map edge "
        .. "smaller than the screen, where the camera stops scrolling but "
        .. "you keep walking, a label can sit a tile or two off.",
      "Interacting with another player's avatar logs 'no text for ...' from "
        .. "the engine before the menu opens: the avatar is a real NPC with "
        .. "no dialogue, and the engine warns on that path.",
      "Only one trade or battle at a time, per player.",
      "A party is exactly two players, and either one leaving ends it for "
        .. "both -- there is no party of one and no third seat. An invite "
        .. "that is never answered stays outstanding until one of them "
        .. "disconnects; nothing expires it.",
      "The hub has a flood gate but no moderation, accounts, or bans. Run "
        .. "one for people you know.",
      "No position interpolation: a remote player walks tile to tile at the "
        .. "engine's step rate, so heavy latency reads as stuttering rather "
        .. "than smooth motion.",
      "Untested against a modded peer with a different link fingerprint "
        .. "beyond what the engine's own handshake already refuses.",
    },
  },

  compat_notes = {
    "Runs alongside DramaticShapeVoxelMod: both load clean and everything "
      .. "works with the diorama on. Remote players render as voxel "
      .. "characters, since this mod spawns real NPCs rather than drawing "
      .. "avatars itself. Nameplates cannot be projected into a 3D world, "
      .. "so they become a corner list while a mod owns the world pass.",
  },

  credits = {
    { who = "bryanthaboi", for_ = "Gen1Recomp, and the link stack this "
      .. "mod's trade and battle run on unmodified" },
  },

  compat = { engine = ">=0.0.0-0 <2.0.0", modApi = 2 },
}
