# AGENTS_CONFIG.yml — per-phase model routing for /implement
#
# Preset: quality (v2). Re-run `/implement --config` to change it.
#
# Role → model mapping across harnesses:
#   Claude opus/fable  → Codex gpt-5.6-sol   → Cursor cursor-grok-4.5-high
#   Claude sonnet      → Codex gpt-5.6-terra → Cursor composer-2.5
#   Claude haiku       → Codex gpt-5.6-luna  → Cursor composer-2.5
#
# See the implement skill's references/agents-config.md for the full schema.

version: 2

# Which harness /implement is running IN (not which model it calls).
# `auto` detects it. When driving from Cursor IDE / cursor-agent, pin
# `host: cursor` (or pass `--host cursor`) — auto may otherwise classify
# Cursor's native Task tool as claude_code and skip the cursor: bindings.
host: auto

defaults:
  strategy: distribute
  allow_orchestrator_override: true
  fallback: builder


# ── Roles ──────────────────────────────────────────────────────────────────
# Claude bindings sit under `any:` (portable: Agent tool on Claude Code,
# `claude -p` elsewhere). `codex:` and `cursor:` override on those hosts.

models:

  orchestrator:
    any: { type: self }

  # Read-only investigation (sonnet-tier).
  scout:
    any:    { type: claude, model: sonnet, subagent_type: Explore }
    codex:  { type: codex,  model: gpt-5.6-terra }
    cursor:
      type: shell
      model: composer-2.5
      command: "agent -p --model composer-2.5 --workspace {CWD} --trust --mode plan --output-format text {PROMPT}"
      unavailable_fallback: scout

  # Writes production code + test fixes (opus-tier).
  builder:
    any:    { type: claude, model: opus }
    codex:  { type: codex,  model: gpt-5.6-sol }
    cursor:
      type: shell
      model: cursor-grok-4.5-high
      command: "agent -p --model cursor-grok-4.5-high --workspace {CWD} --trust --force --output-format text {PROMPT}"
      unavailable_fallback: builder

  # Reviews the diff (opus-tier).
  reviewer:
    any:    { type: claude, model: opus }
    codex:  { type: codex,  model: gpt-5.6-sol }
    cursor:
      type: shell
      model: cursor-grok-4.5-high
      command: "agent -p --model cursor-grok-4.5-high --workspace {CWD} --trust --mode plan --output-format text {PROMPT}"
      unavailable_fallback: reviewer

  # Authors tests (sonnet-tier).
  test_author:
    any:    { type: claude, model: sonnet }
    codex:  { type: codex,  model: gpt-5.6-terra }
    cursor:
      type: shell
      model: composer-2.5
      command: "agent -p --model composer-2.5 --workspace {CWD} --trust --force --output-format text {PROMPT}"
      unavailable_fallback: test_author

  # Runs suites / owns e2e lifecycle (haiku-tier).
  test_runner:
    any:    { type: claude, model: haiku }
    codex:  { type: codex,  model: gpt-5.6-luna }
    cursor:
      type: shell
      model: composer-2.5
      command: "agent -p --model composer-2.5 --workspace {CWD} --trust --force --output-format text {PROMPT}"
      unavailable_fallback: test_runner


# ── Phases ─────────────────────────────────────────────────────────────────

phases:

  investigate:
    use: scout

  planning:
    use: orchestrator

  implementation:
    use: builder
    strategy: distribute

  code_review:
    use: reviewer
    # strategy: race
    # cross_host: true

  tests_creation:
    use: test_author
    strategy: distribute

  tests_running:
    use: test_runner

  tests_fixes:
    use: builder
    strategy: distribute
