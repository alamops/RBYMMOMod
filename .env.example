# Copy to .env (which is gitignored) and fill in.
#
# Read by tools/play.sh and by the end-to-end runners, so neither needs a
# manual step: no ROM picker to click through, no address to type.
#
#   bash mods/rby_mmo/tools/play.sh              # Gen 1 (ROM_PATH)
#   bash mods/rby_mmo/tools/play.sh gold         # Gen 2 Gold (GOLD_ROM_PATH)
#   bash mods/rby_mmo/tests/drivers/run-mmo-e2e.sh
#   bash mods/rby_mmo/tests/drivers/run-mmo-e2e-gen2.sh

# --- Gen 1 ROM (Red / Blue / Yellow) ------------------------------------
# Path to your own legally obtained Red / Blue / Yellow ROM. When the engine
# checkout has no data/generated yet, the runner imports it with this rather
# than dropping you at the game's ROM picker.
#
# Spaces are fine and need no quoting: the runner reads this file line by
# line rather than sourcing it, so nothing here is executed as shell.
#
# Edit this value -- copying the example without changing it leaves a path
# that does not exist, which only bites later, when the game data cache is
# missing and the import is actually needed.
ROM_PATH=/path/to/Pokemon Red.gb

# Optional second cartridge, used by the Red-vs-Yellow battle-compat check
# (tests/drivers/run-red-yellow-battle-compat.sh). Point at Yellow (or Blue)
# when you want that assertion to run; leave unset and the driver skips.
SECONDARY_ROM_PATH=/path/to/Pokemon Yellow.gb

# red | blue | yellow -- which game ROM_PATH is.
#
# This is not cosmetic. scripts/setup.sh never passes --version through to
# the extractor, which defaults to red, so importing Yellow through it fails
# with "unsupported ROM SHA-1 ... expected ea9bcae..." even though the ROM is
# perfectly valid. The runner calls the extractor directly and passes this.
ROM_VERSION=red
SECONDARY_ROM_VERSION=yellow

# --- Gen 2 ROM (Gold) ---------------------------------------------------
# Parallel to ROM_PATH: keep your Gen 1 path above and put Gold here so both
# generations coexist without swapping files.
#
# Canonical US Pokemon Gold (SHA-1 d8b8a3600a465308c9953dfa04f0081c05bdcb94),
# a 2 MiB .gbc. Gen 2 is NOT imported by tools/build_data.py (Gen 1 only) —
# the engine imports it at boot via POKEPORT_IMPORT_ROM + POKEPORT_VERSION=gold,
# writing the cache under the gold/ prefix (gold/data/generated/...).
#
# One-shot import (from the engine checkout, with this mod linked):
#
#   bash mods/rby_mmo/tools/play.sh gold
#
# Or manually:
#
#   POKEPORT_VERSION=gold POKEPORT_IMPORT_ROM="/path/to/Pokemon Gold.gbc" \
#     POKEPORT_IDENTITY=rby-mmo-gold love .
#
# Probe that the cache exists (under the LOVE save identity, or the repo if
# the importer wrote there):
#
#   test -f gold/data/generated/landmarks.lua && echo gold ok
#
GOLD_ROM_PATH=/path/to/Pokemon Gold.gbc
# Always gold for this key (kept explicit so scripts can assert it).
GOLD_ROM_VERSION=gold

# --- multiplayer -------------------------------------------------------
# Address the joining instance dials. Both instances run on this machine, so
# the default is right unless you are pointing a run at a hub elsewhere.
# Leave this alone unless you are pointing the guest at a host somewhere else.
# The runner derives it from the port the host actually binds -- which it picks
# per run so two runs on one machine cannot join each other -- so a pinned
# value here names a port nobody is listening on, and the run fails at the
# handshake with errors that all look like a bad join code. The runner now
# notices and overrides it, but the line is still better deleted than kept.
#MMO_JOIN_ADDRESS=127.0.0.1:7788

# Space-separated mod ids to force on or off for the run, so it pins its own
# rendering path instead of inheriting whatever is installed.
#MMO_WITH_MODS=DRAMATIC_SHAPE
#MMO_WITHOUT_MODS=DRAMATIC_SHAPE

# How many players the hosted game allows (2-64).
#MMO_LIMIT=2
